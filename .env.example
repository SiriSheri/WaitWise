# ==========================================
# WaitWise Environment Configuration Template
# ==========================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# JWT Secret for Session Cryptographic Signing
# Replace with a high-entropy string in production (e.g. openssl rand -base64 32)
JWT_SECRET=your_waitwise_secure_jwt_secret_key_change_in_production

# Client App URL for CORS Configuration
CLIENT_URL=http://localhost:5173
